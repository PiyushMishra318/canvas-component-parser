{
  "name": "canvas-component-parser",
  "version": "2.0.0",
  "description": "COOT/canvas-style component parser — HTML AST to React/JSX and composed pages",
  "main": "src/index.js",
  "bin": {
    "canvas-component-parser": "bin/coot-parser.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "parse:ast": "node bin/coot-parser.js ast fixtures/template.html",
    "parse:react": "node bin/coot-parser.js react fixtures/template.html",
    "compose": "node bin/coot-parser.js compose fixtures/components.sample.json"
  },
  "keywords": ["html", "react", "parser", "jsx", "canvas", "design-to-code"],
  "author": "Piyush Mishra",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "himalaya": "^1.1.0"
  }
}
